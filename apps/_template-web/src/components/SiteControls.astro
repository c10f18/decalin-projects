---
// 우측 상단 고정 컨트롤: 테마(라이트/다크) + 언어(KO/EN) 토글.
import { STRINGS } from '../i18n';
---
<div class="site-controls">
  <button type="button" class="ctrl-btn" data-theme-toggle aria-label={STRINGS.themeToggle.ko} title={STRINGS.themeToggle.ko}>
    <span class="i-sun" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
    </span>
    <span class="i-moon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"/></svg>
    </span>
  </button>
  <button type="button" class="ctrl-btn" data-lang-toggle aria-label={STRINGS.langToggle.ko} title={STRINGS.langToggle.ko}>
    <span class="lang-ko">KO</span>
    <span class="lang-en">EN</span>
  </button>
</div>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var theme = document.querySelector('[data-theme-toggle]');
    if (theme) theme.addEventListener('click', function () {
      var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('site-theme', next); } catch (e) {}
    });
    var lang = document.querySelector('[data-lang-toggle]');
    if (lang) lang.addEventListener('click', function () {
      var next = (root.dataset.lang || 'ko') === 'ko' ? 'en' : 'ko';
      root.lang = next; root.dataset.lang = next;
      try { localStorage.setItem('site-lang', next); } catch (e) {}
    });
  })();
</script>

<style is:global>
  .site-controls .i-moon { display: none; }
  :root[data-theme='dark'] .site-controls .i-sun { display: none; }
  :root[data-theme='dark'] .site-controls .i-moon { display: inline-flex; }
  .site-controls [data-theme-toggle] { padding: 0 0.45rem; }
  .site-controls .i-sun, .site-controls .i-moon { display: inline-flex; align-items: center; }

  .site-controls .lang-en { display: none; }
  .site-controls .lang-ko { color: var(--text); }
  :root[data-lang='en'] .site-controls .lang-ko { display: none; }
  :root[data-lang='en'] .site-controls .lang-en { display: inline; color: var(--text); }
</style>
