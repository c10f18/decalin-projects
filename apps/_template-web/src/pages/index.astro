---
// apps/_template-web/src/pages/index.astro
//
// 🌐 웹 서비스형 프로젝트 템플릿의 홈.
// 이 페이지 자체가 "서비스 화면"이 됩니다. 여기부터 실제 UI를 자유롭게 채우세요.
// (실행파일을 배포하는 다운로드형 프로젝트라면 apps/photo-fold 를 복사하세요.)
import '../styles/theme.css';
import HeadBoot from '../components/HeadBoot.astro';
import SiteControls from '../components/SiteControls.astro';
import T from '../components/T.astro';
import { STRINGS, DEFAULT_LANG } from '../i18n';
---

<html lang={DEFAULT_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Template Web</title>
    <HeadBoot />
  </head>
  <body>
    <SiteControls />
    <main>
      <h1>🌐 서비스 이름</h1>
      <p>여기에 실제 웹 서비스 UI가 들어갑니다. (이 index.astro 를 자유롭게 채우세요.)</p>
      <nav>
        <a href="/intro"><T ko={STRINGS.intro.ko} en={STRINGS.intro.en} /></a> ·
        <a href="/info"><T ko={STRINGS.releaseNotes.ko} en={STRINGS.releaseNotes.en} /></a> ·
        <a href="/wiki"><T ko={STRINGS.wiki.ko} en={STRINGS.wiki.en} /></a> ·
        <a href="/arch"><T ko={STRINGS.architecture.ko} en={STRINGS.architecture.en} /></a> ·
        <a href="/devnote"><T ko={STRINGS.devNote.ko} en={STRINGS.devNote.en} /></a>
      </nav>
    </main>
    <style>
      main { max-width: 720px; margin: 3rem auto; padding: 0 1.5rem; }
      nav a { color: var(--accent); text-decoration: none; }
      nav a:hover { text-decoration: underline; }
    </style>
  </body>
</html>
