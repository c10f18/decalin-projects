---
// 새 프로젝트로 복사하면 SITE_NAME만 바꾸세요.
import '../styles/theme.css';
import HeadBoot from '../components/HeadBoot.astro';
import SiteControls from '../components/SiteControls.astro';
import T from '../components/T.astro';
import { STRINGS, DEFAULT_LANG } from '../i18n';

const SITE_NAME = 'Template Download';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang={DEFAULT_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {SITE_NAME}</title>
    <HeadBoot />
  </head>
  <body>
    <SiteControls />
    <div class="page">
      <slot />
    </div>
    <footer class="site-footer">
      © {new Date().getFullYear()} {SITE_NAME}. <T ko={STRINGS.rights.ko} en={STRINGS.rights.en} />
    </footer>

    <style is:global>
      body { min-height: 100vh; display: flex; flex-direction: column; }
      .page { flex: 1; width: 100%; max-width: 760px; margin: 0 auto; padding: 2.5rem 1.5rem; }
    </style>
  </body>
</html>
