---
// apps/qr-code-converter/src/pages/index.astro — 소개(광고) 랜딩

const REPO_URL = 'https://github.com/c10f18/QR_Code_Converter';
const DOWNLOAD_URL = `${REPO_URL}/releases/latest`;

const features = [
  { icon: '📄', title: '엑셀 일괄 변환', body: 'URL·QR이름 두 열이 담긴 엑셀을 읽어 한 번에 QR 이미지로 변환합니다.' },
  { icon: '🧩', title: '템플릿 생성기', body: '입력용 엑셀 양식을 앱에서 바로 만들어 줍니다.' },
  { icon: '🎛️', title: '출력 커스터마이즈', body: 'PNG/JPG 형식, QR 크기·테두리 두께를 원하는 대로 설정.' },
  { icon: '📊', title: '실시간 진행률', body: '진행 상황·로그 표시, 중복 파일명 자동 처리, 안전한 취소 확인.' },
];
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>QR Code Converter — 엑셀 URL을 QR 이미지로 일괄 변환</title>
    <meta name="description" content="엑셀의 URL 목록을 한 번에 QR 코드 이미지로 변환하는 Windows 유틸리티." />
  </head>
  <body>
    <main>
      <section class="hero">
        <div class="logo">🔳</div>
        <h1>QR Code Converter</h1>
        <p class="lede">엑셀의 URL 목록을 <b>한 번에 QR 코드 이미지로</b> 변환하는 Windows 유틸리티.</p>
        <div class="cta">
          <a class="btn btn-primary" href={DOWNLOAD_URL}>⬇ Windows용 내려받기</a>
          <a class="btn" href={REPO_URL}>GitHub에서 보기</a>
        </div>
        <p class="platform-note">Windows · Python · 설치 없이 실행 (.exe) · GitHub Releases 배포</p>
      </section>

      <section class="shot" aria-hidden="true">
        <div class="shot-placeholder">여기에 스크린샷 (public/images/screenshot.png)</div>
      </section>

      <section class="features">
        {features.map((f) => (
          <div class="feature">
            <div class="feature-icon">{f.icon}</div>
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </section>

      <footer class="site-nav">
        <span>더 알아보기</span>
        <nav>
          <a href="/info">릴리즈 노트</a>
          <a href="/wiki">위키</a>
          <a href="/arch">아키텍처</a>
          <a href="/devnote">개발노트</a>
        </nav>
      </footer>
    </main>

    <style>
      :root { --indigo: #4f46e5; --ink: #1f2328; --muted: #6b7280; }
      * { box-sizing: border-box; }
      body { font-family: system-ui, -apple-system, 'Apple SD Gothic Neo', sans-serif; color: var(--ink); margin: 0; }
      main { max-width: 760px; margin: 0 auto; padding: 3.5rem 1.5rem 4rem; }

      .hero { text-align: center; }
      .logo { font-size: 3.5rem; line-height: 1; }
      .hero h1 { font-size: 2.6rem; margin: 0.6rem 0 0.4rem; }
      .lede { font-size: 1.15rem; color: var(--muted); margin: 0 auto 1.6rem; max-width: 32rem; }
      .lede b { color: var(--ink); }

      .cta { display: flex; gap: 0.7rem; justify-content: center; flex-wrap: wrap; }
      .btn { text-decoration: none; padding: 0.7rem 1.3rem; border-radius: 10px; border: 1px solid #d1d5db; color: var(--ink); font-weight: 600; }
      .btn:hover { border-color: #9ca3af; }
      .btn-primary { background: var(--indigo); border-color: var(--indigo); color: #fff; }
      .btn-primary:hover { background: #4338ca; }
      .platform-note { color: var(--muted); font-size: 0.85rem; margin-top: 0.9rem; }

      .shot { margin: 2.8rem 0; }
      .shot-placeholder {
        border: 2px dashed #d1d5db; border-radius: 14px; color: #9ca3af;
        display: grid; place-items: center; height: 260px; font-size: 0.9rem;
      }

      .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1.2rem; }
      .feature { border: 1px solid #e5e7eb; border-radius: 14px; padding: 1.2rem; }
      .feature-icon { font-size: 1.6rem; }
      .feature h3 { margin: 0.5rem 0 0.3rem; font-size: 1.05rem; }
      .feature p { margin: 0; color: var(--muted); font-size: 0.9rem; line-height: 1.5; }

      .site-nav { margin-top: 3rem; padding-top: 1.4rem; border-top: 1px solid #eee; display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem 1rem; }
      .site-nav > span { color: var(--muted); font-size: 0.85rem; }
      .site-nav nav { display: flex; gap: 1rem; flex-wrap: wrap; }
      .site-nav a { color: var(--indigo); text-decoration: none; font-size: 0.9rem; }
      .site-nav a:hover { text-decoration: underline; }
    </style>
  </body>
</html>
