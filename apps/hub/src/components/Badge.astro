---
// apps/hub/src/components/Badge.astro
// 상태 배지("진행중" 등) + "업데이트됨" 배지. 기준일(RECENT_DAYS)만 바꾸면 전체 반영.
import type { ProjectStatus } from '../data/projects';
import { STRINGS } from '../i18n';
import T from './T.astro';

interface Props {
  status: ProjectStatus;
  updatedAt: string;
}
const { status, updatedAt } = Astro.props;

const STATUS_KEY: Record<ProjectStatus, keyof typeof STRINGS> = {
  active: 'statusActive',
  paused: 'statusPaused',
  done: 'statusDone',
  archived: 'statusArchived',
};
const s = STRINGS[STATUS_KEY[status]];

const RECENT_DAYS = 14;
const isRecentlyUpdated =
  (Date.now() - new Date(updatedAt).getTime()) / (1000 * 60 * 60 * 24) <= RECENT_DAYS;
---
<span class:list={['badge', `badge-${status}`]}><T ko={s.ko} en={s.en} /></span>
{isRecentlyUpdated && (
  <span class="badge badge-updated">
    <T ko={STRINGS.updated.ko} en={STRINGS.updated.en} />
  </span>
)}

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }
  .badge-active { color: var(--h-active); background: color-mix(in oklab, var(--h-active) 15%, var(--bg)); }
  .badge-paused { color: var(--h-paused); background: color-mix(in oklab, var(--h-paused) 15%, var(--bg)); }
  .badge-done { color: var(--h-done); background: color-mix(in oklab, var(--h-done) 15%, var(--bg)); }
  .badge-archived { color: var(--h-archived); background: color-mix(in oklab, var(--h-archived) 15%, var(--bg)); }
  .badge-updated { color: var(--h-updated); background: color-mix(in oklab, var(--h-updated) 15%, var(--bg)); }
</style>
