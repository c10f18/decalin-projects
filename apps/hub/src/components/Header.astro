---
// apps/hub/src/components/Header.astro
// 히어로 헤더: 마크 + 타이틀/태그라인(좌), 소셜 아이콘(우).
import { STRINGS } from '../i18n';
import T from './T.astro';
import SocialLinks from './SocialLinks.astro';
---
<header class="hero">
  <div class="hero-main">
    <span class="hero-mark" aria-hidden="true">
      <img src="/favicon.svg" alt="" width="40" height="40" />
    </span>
    <div class="hero-text">
      <T as="h1" ko={STRINGS.headerTitle.ko} en={STRINGS.headerTitle.en} />
      <T as="p" ko={STRINGS.headerTagline.ko} en={STRINGS.headerTagline.en} />
    </div>
  </div>
  <div class="hero-social">
    <SocialLinks />
  </div>
</header>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding: 1.6rem 1.6rem;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: linear-gradient(135deg, var(--hero-1), var(--hero-2));
    overflow: hidden;
  }
  .hero::after {
    content: '';
    position: absolute;
    right: -60px;
    top: -60px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, color-mix(in oklab, var(--accent) 22%, transparent), transparent 70%);
    pointer-events: none;
  }
  .hero-main { display: flex; align-items: center; gap: 0.9rem; min-width: 0; z-index: 1; }
  .hero-mark {
    display: inline-flex;
    padding: 6px;
    border-radius: 12px;
    background: color-mix(in oklab, var(--accent) 10%, var(--surface));
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .hero-mark img { display: block; }
  .hero-text :global(h1) {
    margin: 0;
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .hero-text :global(p) {
    margin: 0.3rem 0 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .hero-social { z-index: 1; align-self: center; }

  @media (max-width: 560px) {
    .hero { padding: 1.3rem; }
    .hero-social { width: 100%; }
  }
</style>
