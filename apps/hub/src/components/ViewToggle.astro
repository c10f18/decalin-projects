---
// apps/hub/src/components/ViewToggle.astro
// 갤러리(grid) / 리스트(list) 뷰 전환 — 아이콘 전용 세그먼트 토글.
// 기본값은 '리스트'. 선택값은 localStorage('hub-view-mode')에 저장돼 다음 방문 때 유지된다.
import Icon from './Icon.astro';
import { STRINGS } from '../i18n';
---
<div class="view-toggle" role="group" aria-label="보기 방식 전환">
  <button type="button" data-view-btn="list" aria-pressed="true" aria-label={STRINGS.viewList.ko} title={STRINGS.viewList.ko}>
    <Icon name="list" size={18} />
  </button>
  <button type="button" data-view-btn="grid" aria-pressed="false" aria-label={STRINGS.viewGrid.ko} title={STRINGS.viewGrid.ko}>
    <Icon name="grid" size={18} />
  </button>
</div>

<script is:inline>
  (function () {
    function init() {
      var KEY = 'hub-view-mode';
      // 그리드 섹션은 이 컴포넌트보다 뒤에 오므로 DOM 준비 후에 찾는다.
      var grid = document.querySelector('[data-projects]');
      var buttons = document.querySelectorAll('[data-view-btn]');
      if (!grid) return;
      function apply(mode) {
        grid.dataset.view = mode;
        buttons.forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.dataset.viewBtn === mode));
        });
      }
      var saved = 'list';
      try { saved = localStorage.getItem(KEY) || 'list'; } catch (e) {}
      apply(saved);
      buttons.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var mode = btn.dataset.viewBtn;
          try { localStorage.setItem(KEY, mode); } catch (e) {}
          apply(mode);
        });
      });
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  .view-toggle {
    display: inline-flex;
    padding: 3px;
    gap: 2px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface-2);
  }
  .view-toggle button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 30px;
    border: 0;
    border-radius: 7px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
  }
  .view-toggle button:hover { color: var(--text); }
  .view-toggle button[aria-pressed='true'] {
    background: var(--surface);
    color: var(--accent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.08);
  }
</style>
