---
// apps/hub/src/components/ViewToggle.astro
// 갤러리(grid) / 리스트(list) 뷰 전환 버튼. 선택값은 localStorage에 저장해서
// 다음 방문 때도 마지막에 고른 뷰가 유지된다.
---

<div class="view-toggle" role="group" aria-label="보기 방식 전환">
  <button data-view-btn="grid" aria-pressed="true">🖼 갤러리</button>
  <button data-view-btn="list" aria-pressed="false">📋 리스트</button>
</div>

<script>
  const KEY = 'hub-view-mode';
  const grid = document.querySelector('[data-projects]') as HTMLElement | null;
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-view-btn]');

  function apply(mode: string) {
    if (!grid) return;
    grid.dataset.view = mode;
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.viewBtn === mode)));
  }

  const saved = localStorage.getItem(KEY) ?? 'grid';
  apply(saved);

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const mode = btn.dataset.viewBtn!;
      localStorage.setItem(KEY, mode);
      apply(mode);
    });
  });
</script>

<style>
  .view-toggle { display: flex; gap: 0.5rem; margin-bottom: 1.2rem; }
  .view-toggle button {
    border: 1px solid #e5e7eb;
    background: #fff;
    border-radius: 8px;
    padding: 0.35rem 0.8rem;
    cursor: pointer;
    font-size: 0.85rem;
  }
  .view-toggle button[aria-pressed='true'] {
    background: #4f46e5;
    color: #fff;
    border-color: #4f46e5;
  }
</style>
