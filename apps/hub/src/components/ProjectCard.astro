---
// apps/hub/src/components/ProjectCard.astro
import type { Project } from '../data/projects';
import Badge from './Badge.astro';

interface Props {
  project: Project;
}

const { project } = Astro.props;
const isDownload = project.kind === 'download';

// 문서 섹션 링크: 값이 있는 것만 카드에 노출
const docLinks = [
  { href: project.infoUrl, label: '릴리즈 노트' },
  { href: project.wikiUrl, label: '위키' },
  { href: project.archUrl, label: '아키텍처' },
  { href: project.devNoteUrl, label: '개발노트' },
].filter((l): l is { href: string; label: string } => Boolean(l.href));
---

<article class="project-card">
  <div class="badges">
    <Badge status={project.status} updatedAt={project.updatedAt} />
    <span class:list={['kind-chip', `kind-${project.kind}`]}>
      {isDownload ? `⬇ 다운로드${project.platform ? ` · ${project.platform}` : ''}` : '🌐 웹'}
    </span>
  </div>

  <h3><a href={project.url}>{project.name}</a></h3>
  <p class="tagline">{project.tagline}</p>

  <div class="tags">
    {project.tags.map((t) => <span class="tag-chip">#{t}</span>)}
  </div>

  <div class="cta">
    {isDownload ? (
      <>
        {project.downloadUrl && (
          <a class="btn btn-primary" href={project.downloadUrl}>내려받기 →</a>
        )}
        <a class="btn" href={project.url}>소개 페이지</a>
        {project.repoUrl && <a class="btn" href={project.repoUrl}>GitHub</a>}
      </>
    ) : (
      <>
        <a class="btn btn-primary" href={project.url}>서비스 열기 →</a>
        {project.introUrl && <a class="btn" href={project.introUrl}>소개</a>}
        {project.repoUrl && <a class="btn" href={project.repoUrl}>GitHub</a>}
      </>
    )}
  </div>

  {docLinks.length > 0 && (
    <div class="links">
      {docLinks.map((l) => <a href={l.href}>{l.label}</a>)}
    </div>
  )}
</article>

<style>
  .project-card {
    border: 1px solid #e5e7eb;
    border-radius: 14px;
    padding: 1.1rem 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .badges { display: flex; align-items: center; gap: 0.3rem; flex-wrap: wrap; }
  .kind-chip {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
  }
  .kind-download { background: #eef6ff; color: #1d4ed8; }
  .kind-web { background: #edfbf3; color: #0f7a48; }

  .project-card h3 { margin: 0.1rem 0; }
  .project-card h3 a { text-decoration: none; color: inherit; }
  .tagline { color: #6b7280; font-size: 0.9rem; margin: 0; }
  .tags { display: flex; gap: 0.35rem; flex-wrap: wrap; }
  .tag-chip {
    font-size: 0.75rem;
    color: #4f46e5;
    background: #eef0fd;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
  }

  .cta { display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 0.3rem; }
  .btn {
    font-size: 0.85rem;
    text-decoration: none;
    padding: 0.35rem 0.8rem;
    border-radius: 8px;
    border: 1px solid #d1d5db;
    color: #374151;
  }
  .btn:hover { border-color: #9ca3af; }
  .btn-primary {
    background: #4f46e5;
    border-color: #4f46e5;
    color: #fff;
  }
  .btn-primary:hover { background: #4338ca; border-color: #4338ca; }

  .links {
    margin-top: 0.3rem;
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    font-size: 0.85rem;
  }
  .links a { color: #6b7280; text-decoration: none; }
  .links a:hover { text-decoration: underline; }

  /* 리스트 뷰일 때는 가로로 눕힌 카드 형태로 */
  :global([data-view='list']) .project-card {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
  }
  :global([data-view='list']) .project-card h3 { min-width: 160px; }
</style>
