---
// apps/hub/src/pages/index.astro
import { projects } from '../data/projects';
import ProjectCard from '../components/ProjectCard.astro';
import ViewToggle from '../components/ViewToggle.astro';
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Decalin — Side Projects</title>
  </head>
  <body>
    <main>
      <header class="hub-header">
        <h1>Decalin의 사이드 프로젝트</h1>
        <p>취미로 만든 서비스들을 모아둔 곳입니다.</p>
        <ViewToggle />
      </header>

      <section class="project-grid" data-projects data-view="grid">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </section>
    </main>

    <style>
      body {
        font-family: system-ui, -apple-system, 'Apple SD Gothic Neo', sans-serif;
        max-width: 960px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem;
        color: #1f2328;
      }
      .hub-header { margin-bottom: 2rem; }
      .hub-header h1 { margin-bottom: 0.2rem; }
      .hub-header p { color: #6b7280; margin-top: 0; }

      /* 갤러리 뷰: 카드형 그리드 */
      .project-grid[data-view='grid'] {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
        gap: 1rem;
      }
      /* 리스트 뷰: 세로로 쌓인 얇은 목록 */
      .project-grid[data-view='list'] {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
      }
    </style>
  </body>
</html>
