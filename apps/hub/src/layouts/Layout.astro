---
// apps/hub/src/layouts/Layout.astro
// 허브 전역 셸: <head>(파비콘/메타), 색상 토큰(라이트·다크), 언어/테마 부트스트랩, 얇은 푸터.
import { STRINGS, DEFAULT_LANG } from '../i18n';
import { site } from '../data/site';
import T from '../components/T.astro';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = STRINGS.headerTitle.ko,
  description = STRINGS.headerTagline.ko,
} = Astro.props;
---
<!doctype html>
<html lang={DEFAULT_LANG}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#6366f1" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- 플래시 방지: 페인트 전에 저장된(또는 감지한) 테마/언어를 <html>에 적용 -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('hub-theme');
          if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;

          // 언어: 저장값 우선 → 없으면 브라우저 언어 자동감지(ko*면 ko, 그 외 en)
          var l = localStorage.getItem('hub-lang');
          if (l !== 'ko' && l !== 'en') {
            var nav = ((navigator.languages && navigator.languages[0]) || navigator.language || 'ko').toLowerCase();
            l = nav.indexOf('ko') === 0 ? 'ko' : 'en';
          }
          document.documentElement.lang = l;
          document.documentElement.dataset.lang = l;
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <div class="page">
      <slot />
    </div>

    <!-- 우측 하단 떠 있는 "맨 위로" 버튼 (스크롤 시 나타남) -->
    <button type="button" class="to-top" data-to-top aria-label="맨 위로" title="맨 위로">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 19V6M6 12l6-6 6 6" />
      </svg>
    </button>
    <script is:inline>
      (function () {
        var btn = document.querySelector('[data-to-top]');
        if (!btn) return;
        function onScroll() {
          if (window.scrollY > 300) btn.classList.add('is-visible');
          else btn.classList.remove('is-visible');
        }
        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
        btn.addEventListener('click', function () {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        });
      })();
    </script>

    <footer class="site-footer">
      <span>© {site.year} {site.author}. <T ko={STRINGS.rights.ko} en={STRINGS.rights.en} /></span>
    </footer>

    <style is:global>
      /* ===== 색상 토큰: 라이트 기본 ===== */
      :root {
        --bg: #ffffff;
        --surface: #ffffff;
        --surface-2: #f9fafb;
        --border: #e7e8ec;
        --text: #1f2328;
        --text-muted: #6b7280;
        --accent: #4f46e5;
        --accent-hover: #4338ca;
        --accent-fg: #ffffff;
        --ring: rgba(79, 70, 229, 0.35);

        /* 의미색(칩/배지 글자색). 배경은 이 색을 페이지 배경과 섞어서 만든다. */
        --h-active: #1a7f4b;
        --h-updated: #c0392b;
        --h-paused: #92600a;
        --h-done: #2b4fc7;
        --h-archived: #6b7280;
        --h-download: #1d4ed8;
        --h-web: #0f7a48;
        --h-tag: #4f46e5;
        --h-doc: #7c3aed;

        --hero-1: #eef2ff;
        --hero-2: #faf5ff;
      }

      /* 시스템이 다크이고, 사용자가 라이트를 명시하지 않았을 때 */
      @media (prefers-color-scheme: dark) {
        :root:not([data-theme='light']) {
          --bg: #0d1117;
          --surface: #161b22;
          --surface-2: #1c2128;
          --border: #2a2f37;
          --text: #e6edf3;
          --text-muted: #9198a1;
          --accent: #7c74ff;
          --accent-hover: #948dff;
          --accent-fg: #0d1117;
          --ring: rgba(124, 116, 255, 0.4);

          --h-active: #3fb950;
          --h-updated: #ff7b72;
          --h-paused: #e3b341;
          --h-done: #79a9ff;
          --h-archived: #9198a1;
          --h-download: #79a9ff;
          --h-web: #3fb950;
          --h-tag: #a5a1ff;
          --h-doc: #c9a5ff;

          --hero-1: #171a2e;
          --hero-2: #1c1630;
        }
      }

      /* 사용자가 다크를 명시했을 때 (토글) */
      :root[data-theme='dark'] {
        --bg: #0d1117;
        --surface: #161b22;
        --surface-2: #1c2128;
        --border: #2a2f37;
        --text: #e6edf3;
        --text-muted: #9198a1;
        --accent: #7c74ff;
        --accent-hover: #948dff;
        --accent-fg: #0d1117;
        --ring: rgba(124, 116, 255, 0.4);

        --h-active: #3fb950;
        --h-updated: #ff7b72;
        --h-paused: #e3b341;
        --h-done: #79a9ff;
        --h-archived: #9198a1;
        --h-download: #79a9ff;
        --h-web: #3fb950;
        --h-tag: #a5a1ff;
        --h-doc: #c9a5ff;

        --hero-1: #171a2e;
        --hero-2: #1c1630;
      }

      * { box-sizing: border-box; }
      html { color-scheme: light dark; }
      body {
        margin: 0;
        font-family: system-ui, -apple-system, 'Apple SD Gothic Neo', 'Segoe UI', sans-serif;
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        transition: background 0.2s ease, color 0.2s ease;
      }
      .page {
        position: relative;
        flex: 1;
        width: 100%;
        max-width: 980px;
        margin: 0 auto;
        padding: 3rem 1.5rem 3rem;
      }

      /* ===== 언어 토글: 현재 언어에 맞는 문구만 표시 ===== */
      .i18n [lang='en'] { display: none; }
      :root[data-lang='en'] .i18n [lang='ko'] { display: none; }
      :root[data-lang='en'] .i18n [lang='en'] { display: inline; }

      /* ===== 떠 있는 "맨 위로" 버튼 ===== */
      .to-top {
        position: fixed;
        right: 1.25rem;
        bottom: 1.25rem;
        z-index: 50;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 42px;
        height: 42px;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: var(--surface);
        color: var(--accent);
        cursor: pointer;
        box-shadow: 0 6px 18px -4px rgba(0, 0, 0, 0.28);
        opacity: 0;
        transform: translateY(8px);
        pointer-events: none;
        transition: opacity 0.2s ease, transform 0.2s ease, background 0.15s ease;
      }
      .to-top.is-visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
      .to-top:hover { background: color-mix(in oklab, var(--accent) 12%, var(--surface)); }

      /* ===== 얇은 푸터 ===== */
      .site-footer {
        border-top: 1px solid var(--border);
        color: var(--text-muted);
        font-size: 0.72rem;
        text-align: center;
        padding: 0.9rem 1rem;
      }

      a { color: inherit; }
      :focus-visible { outline: 2px solid var(--ring); outline-offset: 2px; border-radius: 6px; }

      /* ===== 컨트롤 버튼 공통 (테마/언어 토글) ===== */
      .ctrl-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 34px;
        height: 34px;
        padding: 0 0.5rem;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: var(--surface-2);
        color: var(--text-muted);
        cursor: pointer;
        transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
      }
      .ctrl-btn:hover { color: var(--text); border-color: color-mix(in oklab, var(--text) 25%, var(--border)); }
    </style>
  </body>
</html>
