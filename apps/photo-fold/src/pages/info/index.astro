---
// apps/photo-fold/src/pages/info/index.astro — 릴리즈 노트 목록
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../../../../packages/docs-viewer/src/PostList.astro';
import { globToPosts } from '../../../../../packages/docs-viewer/src/postUtils';

const modules = import.meta.glob('../../content/changelog/*.md', { eager: true });
const posts = globToPosts(modules);
const activeTag = Astro.url.searchParams.get('tag') ?? undefined;
---

<BaseLayout title="릴리즈 노트">
  <a href="/">← Photo Fold</a>
  <h1>릴리즈 노트</h1>
  <PostList posts={posts} activeTag={activeTag} basePath="/info" />
</BaseLayout>
