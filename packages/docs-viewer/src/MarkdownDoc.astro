---
// packages/docs-viewer/src/MarkdownDoc.astro
//
// 위키 / 개발노트 / 릴리즈노트 공용 "본문" 컴포넌트.
// [slug].astro 페이지에서 매칭된 글 하나를 이 컴포넌트로 감싸서 렌더링한다.

import { formatDate, type PostModule } from './postUtils';
import './docs-viewer.css';

interface Props {
  post: PostModule;
  backHref: string; // 돌아가는 링크, 예: "/wiki" 또는 "/"
  backLabel?: string; // 링크 문구 (기본 "목록으로"). 단일 페이지(아키텍처 등)에서 바꿔 씀
}

const { post, backHref, backLabel = '목록으로' } = Astro.props;
const { Content } = post;
---

<article class="docs-doc">
  <a class="docs-back" href={backHref}>← {backLabel}</a>

  <header class="docs-doc-header">
    {post.pinned && <span class="pin-badge">📌 공지</span>}
    <h1>{post.title}</h1>
    <p class="docs-doc-meta">
      <time>{formatDate(post.date)}</time>
      {post.tags?.map((t) => <span class="tag-chip">#{t}</span>)}
    </p>
  </header>

  <div class="docs-doc-body">
    <Content />
  </div>
</article>
